            "nullable": true
          },
          "latest_year": {
            "type": "object",
            "example": 2024,
            "nullable": true
          }
        },
        "required": [
          "earliest_year",
          "latest_year"
        ]
      },
      "RegionDetailDto": {
        "type": "object",
        "properties": {
          "ags": {
            "type": "string",
            "example": "14612"
          },
          "name": {
            "type": "string",
            "example": "Dresden, Stadt"
