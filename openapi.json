            "nullable": true
          },
          "license_url": {
            "type": "object",
            "example": "https://www.govdata.de/dl-de/by-2-0",
            "nullable": true
          },
          "retrieved_at": {
            "type": "object",
            "example": "2026-06-10T13:30:00.000Z",
