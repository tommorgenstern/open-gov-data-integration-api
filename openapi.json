        "parameters": [
          {
            "name": "region",
            "required": false,
            "in": "query",
            "description": "AGS-Präfix der Region (2/5/8-stellig: Land, Kreis, Gemeinde).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "year",
            "required": false,
            "in": "query",
            "description": "Unfalljahr.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "month",
            "required": false,
            "in": "query",
            "description": "Monat (1–12).",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "weekday",
            "required": false,
            "in": "query",
            "description": "Wochentag (1 = Sonntag … 7 = Samstag, wie im Unfallatlas).",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "hour",
            "required": false,
            "in": "query",
            "description": "Stunde (0–23).",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "category",
            "required": false,
            "in": "query",
            "description": "Unfallkategorie: 1 = Getötete, 2 = Schwerverletzte, 3 = Leichtverletzte.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "participant",
            "required": false,
            "in": "query",
            "description": "Filter auf Beteiligtenart.",
            "schema": {
              "enum": [
                "foot",
                "bike",
                "car",
                "motorbike",
                "truck",
                "other"
              ],
              "type": "string"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "description": "Max. Anzahl Ergebnisse (Standard 50).",
            "schema": {
              "default": 50,
              "type": "number"
            }
          },
          {
            "name": "offset",
            "required": false,
            "in": "query",
            "description": "Offset für Paginierung.",
            "schema": {
              "default": 0,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccidentsResponseDto"
                }
              }
            }
          }
        },
        "tags": [
          "Unfälle"
        ]
      }
    },
    "/accident-statistics": {
      "get": {
        "operationId": "StatisticsController_getStatistics",
        "summary": "Aggregierte Unfallzahlen je Region",
        "description": "Liefert Unfallzahlen je Region auf der gewählten Ebene. Über Parameter lassen sich Ranglisten (sort, limit), Filter (year, category, participant) und Regionen ohne Unfälle (maxCount=0) abbilden. Die Antwort enthält die Herkunfts- und Lizenzangaben der Quellen.",
        "parameters": [
          {
            "name": "groupBy",
            "required": false,
            "in": "query",
            "description": "Gruppierungsdimension der Aggregation.",
            "schema": {
              "default": "region",
              "enum": [
                "region"
              ],
              "type": "string"
            }
          },
          {
            "name": "level",
            "required": true,
            "in": "query",
            "description": "Regionsebene: Bundesland (state), Landkreis (district) oder Gemeinde (municipality).",
            "schema": {
              "enum": [
                "state",
                "district",
                "municipality"
              ],
              "type": "string"
            }
          },
          {
            "name": "parent",
            "required": false,
            "in": "query",
            "description": "AGS-Präfix der übergeordneten Region (z. B. 14 = nur Regionen in Sachsen).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "year",
            "required": false,
            "in": "query",
            "description": "Unfalljahr, z. B. 2023.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "category",
            "required": false,
            "in": "query",
            "description": "Unfallkategorie: 1 = Getötete, 2 = Schwerverletzte, 3 = Leichtverletzte.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "participant",
            "required": false,
            "in": "query",
            "description": "Filter auf Beteiligtenart.",
            "schema": {
              "enum": [
                "foot",
                "bike",
                "car",
                "motorbike",
                "truck",
                "other"
              ],
              "type": "string"
            }
          },
          {
            "name": "per",
            "required": false,
            "in": "query",
            "description": "Bezugsgröße für eine Rate je 100.000: population (Einwohner) oder pkw (zugelassene PKW; nur auf Kreisebene mit Jahr).",
            "schema": {
              "enum": [
                "population",
                "pkw"
              ],
              "type": "string"
            }
          },
          {
            "name": "sort",
            "required": false,
            "in": "query",
            "description": "Sortierung der Ergebnisse (z. B. -count für Ranglisten, -rate für höchste Rate).",
            "schema": {
              "default": "-count",
              "enum": [
                "count",
                "-count",
                "ags",
                "-ags",
                "rate",
                "-rate"
              ],
              "type": "string"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "description": "Maximale Anzahl Ergebniszeilen (z. B. 5 für Top-Ranglisten).",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "offset",
            "required": false,
            "in": "query",
            "description": "Offset für Paginierung (Standard 0).",
            "schema": {
              "default": 0,
              "type": "number"
            }
          },
          {
            "name": "minCount",
            "required": false,
            "in": "query",
            "description": "Nur Regionen mit mindestens dieser Unfallzahl.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "maxCount",
            "required": false,
            "in": "query",
            "description": "Nur Regionen mit höchstens dieser Unfallzahl (maxCount=0 ⇒ Regionen ohne Unfälle).",
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatisticsResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Ungültige Parameter."
          },
          "422": {
            "description": "Unzulässige Kombination (z. B. per=pkw außerhalb der Kreisebene)."
          }
        },
        "tags": [
          "Statistik"
        ]
      }
    },
