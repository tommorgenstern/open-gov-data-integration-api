    "/regions": {
      "get": {
        "operationId": "RegionsController_list",
        "summary": "Regionen auflisten",
        "description": "Listet Regionen (Land, Bundesland, Kreis, Gemeinde) mit Filter und Paginierung.",
        "parameters": [
          {
            "name": "level",
            "required": false,
            "in": "query",
            "description": "Filter auf die Regionsebene.",
            "schema": {
              "enum": [
                "country",
                "state",
                "district",
                "municipality"
              ],
              "type": "string"
            }
          },
          {
            "name": "parent",
            "required": false,
            "in": "query",
            "description": "AGS der übergeordneten Region (z. B. 14 für Kreise in Sachsen).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "required": false,
            "in": "query",
            "description": "Freitextsuche im Regionsnamen.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "description": "Max. Anzahl Ergebnisse (Standard 100).",
            "schema": {
              "default": 100,
              "type": "number"
            }
          },
          {
            "name": "offset",
            "required": false,
            "in": "query",
            "description": "Offset für Paginierung.",
            "schema": {
              "default": 0,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegionListResponseDto"
                }
              }
            }
          }
        },
        "tags": [
          "Regionen"
        ]
      }
    },
    "/regions/{ags}": {
      "get": {
        "operationId": "RegionsController_getOne",
        "summary": "Einzelne Region",
        "description": "Liefert eine Region inkl. Einwohnerzahl und data_coverage (frühestes/spätestes Unfalljahr). AGS „00“ steht für Deutschland gesamt (frühestes Jahr insgesamt).",
        "parameters": [
          {
            "name": "ags",
            "required": true,
            "in": "path",
            "description": "Amtlicher Gemeindeschlüssel, z. B. 14 (Sachsen), 05 (NRW), 00 (Deutschland).",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegionDetailResponseDto"
                }
              }
            }
          },
          "404": {
            "description": "Keine Region mit diesem AGS gefunden."
          }
