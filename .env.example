# ─────────────────────────────────────────────────────────────────────────────
# Single source of truth for configuration. Read by BOTH docker-compose
# (variable interpolation) and the Node app/ETL (via dotenv).
#
# Template: copy once with `cp .env.example .env` (.env itself is gitignored).
# The values are LOCAL DEVELOPMENT credentials for a throwaway Docker database
# that is only reachable via localhost. Change them for any other deployment.
# ─────────────────────────────────────────────────────────────────────────────

# Database name
DB_NAME=unfalldaten

# Owner role: owns the schema + writes. Used by the ETL and to create the DB.
DB_OWNER_USER=etl_owner
DB_OWNER_PASSWORD=etl_owner_pw

# API role: SELECT-only (least privilege). Used by the web service.
DB_API_USER=api_reader
DB_API_PASSWORD=api_reader_pw

# HTTP port of the API
PORT=3000

# Host/port the Node process connects to.
# In Docker these are overridden to the service name `db`; for a local
# (non-Docker) `npm run etl`/`npm start` they point at the published container.
DB_HOST=localhost
DB_PORT=5432
